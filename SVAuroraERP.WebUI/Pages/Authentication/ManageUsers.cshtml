@page
@model SVAuroraERP.WebUI.Pages.Authentication.ManageUsersModel
@{
	ViewData["Title"] = "Manage Users";
}

<!-- start page title -->
<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
			<h4 class="mb-sm-0 font-size-18">Manage Users</h4>

			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
					<li class="breadcrumb-item"><a href="#">Authentication</a></li>
					<li class="breadcrumb-item active">Manage Users</li>
				</ol>
			</div>
		</div>
	</div>
</div>
<div class="card">
	<div class="card-body border-bottom">
		<div class="d-flex align-items-center">
			<h5 class="mb-0 card-title flex-grow-1"></h5>
			<div class="flex-shrink-0">
				<button id="btnAddNew" type="button" class="btn btn-info waves-effect btn-label waves-light" data-bs-toggle="modal" data-bs-target="#divAddEditModal" title="Click here to Add New">
					<i class="fas fa-plus-square label-icon"></i>Add New
				</button>
				<button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
					<i class="mdi mdi-refresh label-icon"></i>Refresh
				</button>
			</div>
		</div>
	</div>
	<div class="card-body p4">
		<ul class="nav nav-pills nav-justified" role="tablist">
			<li class="nav-item waves-effect waves-light" role="presentation">
				<a class="nav-link active" data-bs-toggle="tab" href="#home-1" role="tab" aria-selected="false" tabindex="-1">
					<span class="d-block d-sm-none"><i class="fas fa-home"></i></span>
					<span class="d-none d-sm-block">Inventory</span>
				</a>
			</li>
			<li class="nav-item waves-effect waves-light" role="presentation">
				<a class="nav-link " data-bs-toggle="tab" href="#profile-1" role="tab" aria-selected="true">
					<span class="d-block d-sm-none"><i class="far fa-user"></i></span>
					<span class="d-none d-sm-block">HSRP Portal</span>
				</a>
			</li>
		</ul>
		<div class="tab-content p-3 text-muted">
			<div class="tab-pane active show" id="home-1" role="tabpanel">
				<div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
					<table id="tblinventoryrecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
						<thead class="table-light">
							<tr>
								<th>S No.</th>
								<th>Username</th>
								<th>Role</th>
								<th>First Name</th>
								<th>Last Name</th>
								<th>Landing Page</th>
								<th>Status</th>
								<th class="text-center">Action</th>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>
			</div>
			<div class="tab-pane " id="profile-1" role="tabpanel">
				<div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
					<table id="tblhsrprecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
						<thead class="table-light">
							<tr>
								<th>S No.</th>
								<th>Username</th>
								<th>Role</th>
								<th>First Name</th>
								<th>Last Name</th>
								<th>Landing Page</th>
								<th>Status</th>
								<th class="text-center">Action</th>
							</tr>
						</thead>
						<tbody>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade bd-example-modal-lg" id="divAddEditModal" role="dialog">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header text-bg-info ">
				<h5 class="modal-title mt-0" id="myModalLabel"><i class="bx bxs-plus-square font-size-20 align-middle me-1"></i>&nbsp;&nbsp;Add New User</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body bg-white">
				<div class="row g-3 mb-3">
					<div class="form-group col-lg-6" id="divFirstname">
						<label>First Name&nbsp;<span class="text-danger">*</span></label>
						<input type="text" id="txtFirstName" class="form-control MaxThreshold" asp-for="UserData.FirstName" placeholder="Please enter First Name" maxlength="100" />
					</div>
					<div class="form-group col-lg-6" id="divLastname">
						<label>Last Name</label>
						<input type="text" id="txtLastName" class="form-control MaxThreshold" asp-for="UserData.LastName" placeholder="Please enter Last Name" maxlength="100" />
					</div>

					<div class="form-group col-lg-6" id="divEmail">
						<label>Email&nbsp;<span class="text-danger">*</span></label>
						<input type="text" id="txtEmail" class="form-control MaxThreshold" placeholder="Please enter Email" maxlength="200" />
					</div>
					<div class="form-group col-lg-6" id="divUserName">
						<label>User Name&nbsp;<span class="text-danger">*</span></label>
						<input type="text" id="txtUserName" class="form-control MaxThreshold" placeholder="Please enter Username" maxlength="150" />
					</div>
				</div>

				<div id="password" class="row g-3 mb-3">
					<div class="form-group col-lg-6" id="divPassword">
						<label>Password</label>&nbsp;<span class="text-danger">*</span>
						<input type="password" class="form-control MaxThreshold" id="txtPassword" placeholder="Password" maxlength="50" />
					</div>
					<div class="form-group col-lg-6" id="divCPassword">
						<label>Confirm Password</label>&nbsp;<span class="text-danger">*</span>
						<input type="password" class="form-control MaxThreshold" id="txtConfirmPassword" placeholder="Confirm Password" maxlength="50" />
					</div>
				</div>
				<div class="row g-3">
					<div class="form-group  col-lg-6">
						<label>Application&nbsp;<span class="text-danger">*</span></label>
						<select id="ddlApplication" class="form-select select2" asp-data-placeholder="Select Application">
						</select>
					</div>
					<div class="form-group col-lg-6" id="divUserRole">
						<label>Role</label>&nbsp;<span class="text-danger">*</span>
						<select id="ddlUserRole" class="form-select select2" asp-data-placeholder="Select Role">
						</select>
					</div>
					<div class="form-group col-lg-6" id="divLandingPage">
						<label>
							Landing Page
						</label>&nbsp;<span class="text-danger">*</span>
						<select id="ddlPageList" class="form-select select2" name=""
								asp-data-placeholder="Select Page">
							  <option value="0">--Select Page--</option>
						</select>
					</div>
					<div class="form-group col-lg-6 mb-0">
						<div class="checkbox checkbox-success">
							<input id="chkStatus" type="checkbox" checked="checked" />
							<label for="chkStatus">Active</label>
						</div>
					</div>
				</div>
			</div>

			<div class="modal-footer d-flex justify-content-between">
				<button id="btnClose" type="button" class="btn btn-outline-danger waves-effect" data-bs-dismiss="modal"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
				<button id="btnSave" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-save font-size-20 align-middle me-2"></i>Save</button>
				<button id="btnUpdate" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-edit font-size-20 align-middle me-2"></i>Update</button>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="divChangePasswordModal" role="dialog">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title text-primary"><i class="mdi mdi-key-change font-size-20 align-middle me-1"></i> Change Password</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body bg-white">
				<div class="row g-3 mb-3">
					<div class="form-group col-lg-12">
						<label>New Password&nbsp;<span class="text-danger">*</span></label>
						<input type="password" class="form-control MaxThreshold" id="txtNewPassword" placeholder="Enter New Password" maxlength="50" />
					</div>
					<div class="form-group col-lg-12">
						<label>Confirm Password&nbsp;<span class="text-danger">*</span></label>
						<input type="password" class="form-control MaxThreshold" id="txtConfirmNewPassword" placeholder="Confirm New Password" maxlength="50" />
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-success" id="btnChangePassword">
					<i class="mdi mdi-key-change font-size-16 me-2"></i>Change Password
				</button>
			</div>
		</div>
	</div>
</div>

<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
@section Scripts {
	<input type="hidden" id="hdnUserID" />

	<script type="text/javascript">
		  // Define the URL as a JavaScript variable
		var ListDataUrl  = '@Url.Page("/Authentication/ManageUsers", "UsersList")';
		var SaveUpdateDataUrl = '@Url.Page("/Authentication/ManageUsers", "SaveUpdateData")';
		var ListPageControlURL = '@Url.Page("/Authentication/ManageUsers", "PageControlList")';
		var DeleteDataUrl = '@Url.Page("/Authentication/ManageUsers", "DeleteData")';
		var GetByIDDataUrl = '@Url.Page("/Authentication/ManageUsers", "UserByID")';
	    var ApplicationListUrl = '@Url.Page("/GlobalFunctions", "ApplicationList")';
		var GetRoleByApplicationIDUrl = '@Url.Page("/Authentication/ManageUsers", "RoleByApplicationID")';
		var ChangePasswordUrl = '@Url.Page("/Authentication/ManageUsers", "ChangePassword")';

		var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');


		var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
		var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
		var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
		var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
		var _CMPermissions  = @Json.Serialize(Model.Permissions);
		var currentPageControlID = @Model.CurrentPageControlID;
	</script>

	<script src="~/customjs/authentication/jmanageuser.js" type="text/javascript" asp-append-version="true"></script>

	<script type="text/javascript">
		$(document).ready(function () {
			   var PageAuditData = new Object();
			PageAuditData.PageControlID = currentPageControlID;
			PageAuditData.URL = window.location.href;
			InsertPageAccessAuditLog(_TOKEN, PageAuditData);
		});
	</script>
}