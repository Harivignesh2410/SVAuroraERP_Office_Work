@page
@model SVAuroraERP.WebUI.Pages.Dealer.DealerCalendarModel
@{
    ViewData["Title"] = "Dealer Calendar";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Dealer Calendar</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Dealer</a></li>
                    <li class="breadcrumb-item active">Dealer Calendar</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="WebPageContent d-none">
    <div class="card">
        <div class="card-body border-bottom">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">OEM</label>
                    <select id="filterOEM" class="form-select select2">
                        <option value="0">--All OEM--</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dealer</label>
                    <select id="filterDealer" class="form-select select2">
                        <option value="0">--All Dealers--</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-flex gap-2">
                        <button id="btnFilter" type="button" class="btn btn-primary waves-effect waves-light flex-fill">
                            <i class="mdi mdi-filter"></i>Filter
                        </button>
                        <button id="btnClearFilter" type="button" class="btn btn-secondary waves-effect waves-light flex-fill" title="Clear all filters">
                            <i class="mdi mdi-filter-remove"></i>Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="btn-group" role="group" aria-label="Calendar Navigation">
                    <button id="btnPrev" type="button" class="btn btn-light waves-effect waves-light" title="Previous">
                        <i class="mdi mdi-chevron-left"></i>
                    </button>
                    <button id="btnToday" type="button" class="btn btn-light waves-effect waves-light" title="Today">
                        Today
                    </button>
                    <button id="btnNext" type="button" class="btn btn-light waves-effect waves-light" title="Next">
                        <i class="mdi mdi-chevron-right"></i>
                    </button>
                </div>
                <div id="calendarTitle" class="h5 mb-0"></div>
                <div class="btn-group" role="group" aria-label="View Type">
                    <button id="btnViewMonth" type="button" class="btn btn-primary waves-effect waves-light active" data-view="month">
                        Month
                    </button>
                    <button id="btnViewWeek" type="button" class="btn btn-light waves-effect waves-light" data-view="week">
                        Week
                    </button>
                    <button id="btnViewDay" type="button" class="btn btn-light waves-effect waves-light" data-view="day">
                        Day
                    </button>
                </div>
            </div>
            <div id="calendar" style="height: 800px;"></div>
        </div>
    </div>
</div>

<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>

@section Scripts {
       <script type="text/javascript">
        var GetCalendarDataUrl = '@Url.Page("/Dealer/DealerCalendar", "CalendarData")';
        var GetDealersByOEMIDUrl = '@Url.Page("/Dealer/DealerCalendar", "DealersByOEMID")';
        var OEMList = @Json.Serialize(Model.OEMList.Where(t => t.Value != "0").Select(t => new { Value = t.Value, Text = t.Text }));
        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
    </script>
       
    <script src="~/customjs/dealer/jdealercalendar.js" type="text/javascript" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var PageAuditData = new Object();
            PageAuditData.PageControlID = @Model.CurrentPageControlID;
            PageAuditData.URL = window.location.href;
            InsertPageAccessAuditLog(_TOKEN, PageAuditData);
        });
    </script>
}