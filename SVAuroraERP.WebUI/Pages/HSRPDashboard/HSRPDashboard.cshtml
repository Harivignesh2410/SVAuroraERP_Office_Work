@page
@model SVAuroraERP.WebUI.Pages.HSRPDashboard.HSRPDashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Dashboard</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="WebPageContent d-none">
    <div class="card-body">
        <div class="card mb-4">
            <div class="card-body">
                <div class="row" id="summaryColumns">
                    <!-- OEM ORDERS -->
                    <div class="col-md-4">
                        <div class="card bg-warning text-white shadow-sm h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
                                    <i class="fas fa-industry fa-3x"></i>
                                </div>
                                <div class="text-end w-100">
                                    <h4 class="mb-1">OEM Orders</h4>
                                    <h2 class="fw-bold mb-0" id="summaryOEM">0</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ONLINE ORDERS -->
                    <div class="col-md-4">
                        <div class="card bg-primary text-white shadow-sm h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
                                    <i class="fas fa-globe fa-3x"></i>
                                </div>
                                <div class="text-end w-100">
                                    <h4 class="mb-1">Online Orders</h4>
                                    <h2 class="fw-bold mb-0" id="summaryOnline">0</h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- GRAND TOTAL -->
                    <div class="col-md-4">
                        <div class="card bg-success text-white shadow-sm h-100">
                            <div class="card-body d-flex align-items-center">
                                <div class="me-3">
                                    <i class="fas fa-layer-group fa-3x"></i>
                                </div>
                                <div class="text-end w-100">
                                    <h4 class="mb-1">Grand Total</h4>
                                    <h2 class="fw-bold mb-0" id="summaryTotal">0</h2>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <!-- Nav tabs -->
                <ul class="nav nav-pills nav-justified" role="tablist">
                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link active"
                           data-bs-toggle="tab"
                           href="#OEMOrder"
                           role="tab"
                           aria-selected="true">
                            <span class="d-block d-sm-none"><i class="fas fa-home"></i></span>
                            <span class="d-none d-sm-block">OEM Order </span>
                        </a>
                    </li>
                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link"
                           data-bs-toggle="tab" href="#OnlineOrder" role="tab" aria-selected="false">
                            <span class="d-block d-sm-none"><i class="far fa-user"></i></span>
                            <span class="d-none d-sm-block">Online Order </span>
                        </a>
                    </li>
                </ul>

                <!-- Tab panes -->
                <div class="tab-content p-3 text-muted">
                    <div class="tab-pane fade show active" id="OEMOrder" role="tabpanel">
                        <div class="row g-3" id="oemOrderCards"></div>
                    </div>
                    <div class="tab-pane fade" id="OnlineOrder" role="tabpanel">
                        <div class="row g-3" id="OnlineOrderCards"></div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>
        <span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
        @section Scripts {

            <script type="text/javascript">
        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
        var SummaryListUrl = '@Url.Page("/HSRPDashboard/HSRPDashboard", "HsrpDashboard")';
        var GetRedirectUrl = '@Url.Page("/HSRPDashboard/HSRPDashboard", "Redirect")';

        var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
        var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
        var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
        var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
        var _CMPermissions  = @Json.Serialize(Model.Permissions);
        var currentPageControlID = @Model.CurrentPageControlID;
            </script>
            <script src="~/customjs/hsrpdashboard/jhsrpdashboard.js" type="text/javascript" asp-append-version="true"></script>

            <script type="text/javascript">
                $(document).ready(function () {
                    var PageAuditData = new Object();
                    PageAuditData.PageControlID = currentPageControlID;
                    PageAuditData.URL = window.location.href;
                    InsertPageAccessAuditLog(_TOKEN, PageAuditData);
                });
            </script>
        }
