@page
@model SVAuroraERP.WebUI.Pages.Inventory.Dispatch.DispatchModel
@{
    ViewData["Title"] = "Dispatch";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Dispatch</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Inventory</a></li>
                    <li class="breadcrumb-item active">Disptach</li>
                    <li class="breadcrumb-item active">Dispatch</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="WebPageContent d-none">
    <div class="card" id="divRecords">
        <div class="card-body border-bottom">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 card-title flex-grow-1"></h5>
                <div class="flex-shrink-0">
                    <button id="btnAddNew" type="button" class="btn btn-info waves-effect btn-label waves-light" title="Click here to Add New">
                        <i class="fas fa-plus-square label-icon"></i>Add New
                    </button>
                    <button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
                        <i class="mdi mdi-refresh label-icon"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body table-responsive">
            <table id="tblrecordlist" class="table align-middle dt-responsive nowrap w-100">
                <thead class="table-light">
                    <tr>
                        <th>S No.</th>
                        <th>Dispatch No</th>
                        <th>Date</th>
                        <th>Box Name</th>
                        <th>Color Name</th>
                        <th>No of Inner Box</th>
                        <th>Total No.of.Plates</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card" id="divAddEdit">
        <div class="card-header bg-info bg-gradient d-flex justify-content-between align-items-center">
            <h5 class="card-title text-white" id="divCardTitle">
            </h5>
            <button type="button" class="btn btn-sm btn-danger text-white" id="btnCloseWindow" title="Click here to Close Window"><i class="fas fa-window-close align-middle"></i></button>
        </div>
        <div class="card-body">
            <p class="card-title-desc text-danger mb-0">Please fill in all required fields&nbsp;*</p>
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="form-group" id="divDispatchNo">
                        <label class="col-form-label">Dispatch No</label>
                        <input type="text" id="txtDispatchNo" class="form-control" placeholder="Request No. [Auto Filled]" maxlength="50" readonly />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group" id="divDispatchDate">
                        <label class="col-form-label">Dispatch Date&nbsp;<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                            <input type="text" id="txtDispatchDate" class="form-control" name="StartDate" readonly="true" title="Click to view Calendar">
                            <div class="input-group-text ClearDate"><i class="fas fa-eraser"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12">
                    <label class="col-form-label">Mode of Transport<span class="text-danger">&nbsp;*</span></label>
                    <select class="form-select" id="ddlModeOfTransport">
                        <option selected="selected" value="0">--Select--</option>
                        <option value="1">Courier Vehicle</option>
                        <option value="2">Own Vehicle</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12" id="divVehicleDropdown">
                    <label class="col-form-label">Vehicle No <span class="text-danger">*</span></label>
                    <select id="ddlVehicle" class="form-select MaxThreshold select2" asp-items="Model.CourierList" asp-data-placeholder="Select Vehicle No">
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 col-sm-12" id="divVehicle">
                    <div class="form-group">
                        <label class="col-form-label">Vehicle No</label>
                        <input type="text" id="txtVehicle" class="form-control" maxlength="50" placeholder="Please enter Vehicle No" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group" id="divDocketNo">
                        <label class="col-form-label">Docket No</label>
                        <input type="text" id="txtDocketNo" class="form-control" placeholder="Docket No" maxlength="50" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-group" id="divDocketDate">
                        <label class="col-form-label">Docket Date&nbsp;<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                            <input type="text" id="txtDocketDate" class="form-control" name="StartDate" readonly="true" title="Click to view Calendar">
                            <div class="input-group-text ClearDate"><i class="fas fa-eraser"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-12" id="divDispatchedTo">
                    <div class="form-group">
                        <label class="col-form-label">Dispatched To</label>
                        <input type="text" id="txtDispatchedTo" class="form-control" maxlength="50" placeholder="Dispatched To" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-sm-12" id="divEmbossingStation">
                    <div class="form-group">
                        <label class="col-form-label">Embossing Station</label>
                        <input type="text" id="txtEmbossingStation" class="form-control" maxlength="50" placeholder="Please enter Embossing Station " />
                    </div>
                </div>

                <div id="divPackingList"></div>
                <div class="row d-flex justify-content-between mt-2" id="divRecordLog">
                    <div class="col-md-6">
                        <span class="fw-lighter fst-italic" id="spnLastUpdatedBy"></span>
                    </div>
                    <div class="col-md-6">
                        <span class="fw-lighter fst-italic float-end" id="spnLastUpdatedDate"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between mt-2">
                <button id="btnClose" type="button" class="btn btn-outline-danger waves-effect"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
                <button id="btnSave" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-save font-size-20 align-middle me-2"></i>Save</button>
                <button id="btnUpdate" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-save font-size-20 align-middle me-2"></i>Update</button>
            </div>
        </div>
    </div>
    <div class="modal fade" id="divAddEditModal" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl ">
            <div class="modal-content ">
                <div class="modal-header bg-info">
                    <h5 class="modal-title add-task-title text-white" style="display: block;"><i class="fas fa-eye font-size-20 align-middle me-1"></i>View Inner Box</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="divInnerBoxes"></div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger waves-effect" data-bs-dismiss="modal"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
@section Scripts {
    <input type="hidden" id="hdnDispatchID" />

    <script type="text/javascript">
		var SaveUpdateDataUrl = '@Url.Page("/Inventory/Dispatch/Dispatch", "SaveUpdateData")';
		var ListDataUrl = '@Url.Page("/Inventory/Dispatch/Dispatch", "ListData")';
		var GetDataByIDUrl = '@Url.Page("/Inventory/Dispatch/Dispatch", "DispatchByID")';
		var GetPackingListUrl = '@Url.Page("/Inventory/Dispatch/Dispatch", "ListData")';
		var GetDataByIDUrl = '@Url.Page("/Inventory/Dispatch/Packing", "PackingByID")';

		var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
        // Pass permissions to JavaScript
        @*var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
        var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
        var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
        var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
        var _CMPermissions  = @Json.Serialize(Model.Permissions);
        var currentPageControlID = @Model.CurrentPageControlID;*@
    </script>

    <script src="~/customjs/inventory/dispatch/jdispatch.js" type="text/javascript" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var PageAuditData = new Object();
            PageAuditData.PageControlID = currentPageControlID;
            PageAuditData.URL = window.location.href;
            InsertPageAccessAuditLog(_TOKEN, PageAuditData);

        });
    </script>
}