@page
@model SVAuroraERP.WebUI.Pages.Inventory.Master.CategoryModel
@{
	ViewData["Title"] = "Category";
}

<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
			<h4 class="mb-sm-0 font-size-18">Category</h4>

			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
					<li class="breadcrumb-item"><a href="#">HR</a></li>
					<li class="breadcrumb-item active">Category</li>
				</ol>
			</div>
		</div>
	</div>
</div>

<div class="WebPageContent d-none">
	<div class="card">
		<div class="card-body border-bottom">
			<div class="d-flex align-items-center">
				<h5 class="mb-0 card-title flex-grow-1"></h5>
				<div class="flex-shrink-0">
					<button id="btnAddNew" type="button" class="btn btn-info waves-effect btn-label waves-light">
						<i class="fas fa-plus-square label-icon"></i>Add New
					</button>
					<button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
						<i class="mdi mdi-refresh label-icon"></i>Refresh
					</button>
				</div>
			</div>
		</div>
		<div class="card-body p4">
			<div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
				<table id="tblrecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
					<thead class="table-light">
						<tr>
							<th>S No.</th>
							<th>Code</th>
							<th>Category Name</th>
							<th class="text-center">Status</th>
							<th class="text-center">Action</th>
						</tr>
					</thead>
					<tbody>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="modal fade" id="divAddEditModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header bg-info">
					<h5 class="modal-title add-task-title text-white" style="display: block;"><i class="bx bxs-plus-square font-size-20 align-middle me-1"></i> Add New Task</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p class="card-title-desc mb-0">Please fill in all required fields&nbsp;<span class="text-danger">*</span></p>
					<div class="row mb-3">
						<div class="col-lg-12">
							<div class="form-group" id="divCategoryCode">
								<label for="txtCategoryCode" class="col-form-label">Category Code&nbsp;<span class="text-danger me-1">*</span></label>
								<input id="txtCategoryCode" name="txtCategoryCode" type="text" class="form-control MaxThreshold" placeholder="Please enter Category Code..." maxlength="50">
							</div>
							<div class="form-group" id="divCategoryName">
								<label for="txtCategoryName" class="col-form-label">Category Name&nbsp;<span class="text-danger me-1">*</span></label>
								<input id="txtCategoryName" name="txtCategoryName" type="text" class="form-control MaxThreshold" placeholder="Please enter Category Name..." maxlength="250">
							</div>
							<div class="form-check mt-2">
								<input class="form-check-input bg-success" type="checkbox" id="chkActive" checked="checked">
								<label class="form-check-label" for="chkActive">
									Active
								</label>
							</div>
						</div>
					</div>
					<div class="row d-flex justify-content-between" id="divRecordLog">
						<div class="col-md-6">
							<span class="fw-lighter fst-italic" id="spnLastUpdatedBy"></span>
						</div>
						<div class="col-md-6">
							<span class="fw-lighter fst-italic" id="spnLastUpdatedDate"></span>
						</div>
					</div>
				</div>
				<div class="modal-footer d-flex justify-content-between">
					<button id="btnClose" type="button" class="btn btn-outline-danger waves-effect" data-bs-dismiss="modal"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
					<button id="btnSave" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-save font-size-20 align-middle me-2"></i>Save</button>
					<button id="btnUpdate" type="button" class="btn btn-success waves-effect waves-light"><i class="bx bxs-edit font-size-20 align-middle me-2"></i>Update</button>
				</div>
			</div><!-- /.modal-content -->
		</div><!-- /.modal-dialog -->
	</div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>

@section Scripts {
	<input type="hidden" id="hdnCategoryID" />

	<script type="text/javascript">
			// Define the URL as a JavaScript variable
		var SaveUpdateDataUrl = '@Url.Page("/Inventory/Master/Category", "SaveUpdateData")';
		var ListDataUrl = '@Url.Page("/Inventory/Master/Category", "CategoryDataTable")';
		var GetDataByIDUrl = '@Url.Page("/Inventory/Master/Category", "CategoryByID")';
		var DeleteDataUrl = '@Url.Page("/Inventory/Master/Category", "DeleteData")';

		var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
		// Pass permissions to JavaScript
		var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
		var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
		var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
		var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
		var _CMPermissions  = @Json.Serialize(Model.Permissions);
		var currentPageControlID = @Model.CurrentPageControlID;
	</script>

	<script src="~/customjs/inventory/master/jcategory.js" type="text/javascript" asp-append-version="true"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			var PageAuditData= new Object();
			PageAuditData.PageControlID = currentPageControlID;
			PageAuditData.URL = window.location.href;
			InsertPageAccessAuditLog(_TOKEN,PageAuditData);
		});
	</script>
}