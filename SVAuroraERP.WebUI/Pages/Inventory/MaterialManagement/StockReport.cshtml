@page
@model SVAuroraERP.WebUI.Pages.Inventory.MaterialManagement.StockReportModel
@{
	ViewData["Title"] = "Stock Report";
}
<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
			<h4 class="mb-sm-0 font-size-18">Stock Report</h4>

			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
					<li class="breadcrumb-item"><a href="#">Inventory</a></li>
					<li class="breadcrumb-item"><a href="#">Material Management</a></li>
					<li class="breadcrumb-item active">Stock Report</li>
				</ol>
			</div>
		</div>
	</div>
</div>
<div class="WebPageContent d-none">
	<div id="divSearchPage">
		<div class="row g-3 mb-3">
			<div class="col-md-3">
				<div class="form-group" id="divitem">
					<label class="col-form-label">Item Name</label>
					<select id="ddlItem" class="form-control select2" data-placeholder="Item" asp-items="Model.ItemList">
					</select>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group" id="divitem">
					<label class="col-form-label">Component Type</label>
					<select id="ddlComponentType" class="form-control select2" data-placeholder="Componenet Type" asp-items="Model.ComponentList">
					</select>
				</div>
			</div>
			<div class="col-md-3">
				<label class="col-form-label">Search text</label>
				<div class="input-group">
					<span class="input-group-text">
						<i class="fas fa-search"></i>
					</span>
					<input type="text" id="txtSearchbox" class="form-control Maxthreshold" placeholder="Search Text" maxlength="50">
				</div>
			</div>
			<div class="col-md-1">
				<label class="col-form-label"></label>
				<button type="button" class="btn btn-outline-secondary btn-rounded waves-effect w-100" id="btnClearFilter">
					<i class="bi bi-x-circle"></i>Clear
				</button>
			</div>
			<div class="col-md-1">
				<label class="col-form-label"></label>
				<button class="btn btn-warning btn-rounded w-100 waves-effect" id="btnFilter">
					<i class="bx bx-filter-alt font-size-16 align-middle me-2"></i>Filter
				</button>
			</div>
		</div>
	
		<div class="card" id="divSearchResultSummary">
		</div>
	</div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>

@section Scripts {
	<input type="hidden" id="hdnPurchaseTransID" />
	<input type="hidden" id="hdnMaterialInwardInspectionID" />
	<input type="hidden" id="hdnSNo" />

	<script type="text/javascript">
		var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');

		// Define the URL as a JavaScript variable
		//var GetMaterialInwardDataUrl = '@Url.Page("/Inventory/MaterialManagement/PendingInspection", "MaterialList")';

		var GetPendingInspectionByFilterUrl = '@Url.Page("/Inventory/MaterialManagement/StockReport", "StockReportByFilter")';
	</script>

	<script src="~/customjs/inventory/materialinspection/jstockreport.js" type="text/javascript" asp-append-version="true"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			var PageAuditData= new Object();
			PageAuditData.PageControlID = currentPageControlID;
			PageAuditData.URL = window.location.href;
			InsertPageAccessAuditLog(_TOKEN,PageAuditData);
		});
	</script>
	<script>
		$(document).ready(function () {
			$("#ddlSupplierType, #ddlComponentType").select2({
				width: '100%',
				dropdownParent: $("#divsidebar")
			});
		});
	</script>
}
