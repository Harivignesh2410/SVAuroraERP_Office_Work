								<select id="ddlDocumentGroup" class="form-control select2 " data-placeholder="Document Group" asp-items="Model.DocumentGroupList">
								</select>
							</div>
						</div>
						<div class="col-lg-4 col-md-6 ">
							<label>Upload File<span class="text-danger">*</span></label>
							<input class="form-control" type="file" id="fileUpload">
						</div>
						<div class="col-md-4 d-flex align-items-end">
							<button class="btn btn-primary" id="btnUpload"><i class="fa fa-upload me-2 align-middle"></i> Upload</button>
						</div>
					</div>
					<div class="table-responsive mt-2">
						<div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
							<div id="divtableDocument"></div>
						</div>
					</div>
				</div>
			</div>

