@page
@model SVAuroraERP.WebUI.Pages.Inventory.Purchase.PurchaseEntryModel
@{
	ViewData["Title"] = "Purchase Entry";
}
<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
			<h4 class="mb-sm-0 font-size-18">Purchase Entry</h4>

			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
					<li class="breadcrumb-item"><a href="#">Inventory</a></li>
					<li class="breadcrumb-item"><a href="#">Purchase</a></li>
					<li class="breadcrumb-item active">Purchase Entry</li>
				</ol>
			</div>
		</div>
	</div>
</div>
<div class="WebPageContent d-none">
	<div class="card" id="divRecords">
		<div class="card-body border-bottom">
			<div class="d-flex align-items-center">
				<h5 class="mb-0 card-title flex-grow-1"></h5>
				<div class="flex-shrink-0">
					<button id="btnAddNew" type="button" class="btn btn-info waves-effect btn-label waves-light" title="Click here to Add New">
						<i class="fas fa-plus-square label-icon"></i>Add New
					</button>
					@* <button type="button" class="btn btn-soft-info right-bar-toggle waves-effect w-md" title="Click here to Filter"> *@
					@* 	<i class="mdi mdi-filter-outline label-icon"></i>Filter *@
					@* </button> *@
					<button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light " title="Click here to refresh">
						<i class="mdi mdi-refresh label-icon"></i>Refresh
					</button>
				</div>
			</div>
		</div>
		<div class="card-body">
			<div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
				<table id="tblrecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
					<thead class="table-light">
						<tr>
							<th>S No.</th>
							<th>Bill No</th>
							<th>Date</th>
							<th>Supplier</th>
							<th>Total Nos</th>
							<th>Total Qty</th>
							<th>Total ItemTax</th>
							<th>Gross Amount (Rs.)</th>
							<th>Tax Amount (Rs.)</th>
							<th>Bill Amount (Rs.)</th>
							<th>Status</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<div class="card" id="divAddEdit">
		<div class="card-header bg-info bg-gradient d-flex justify-content-between align-items-center">
			<h5 class="card-title text-white" id="divCardTitle">
				<i class="fas fa-plus-square align-middle me-1"></i>
			</h5>
			<button type="button" class="btn-close btn-close-white" id="btnCloseWindow"></button>
		</div>
		<div class="card-body">
			<div id="divPurchaseOrderDetails">
			</div>
			<ul class="nav nav-tabs nav-tabs-custom nav-justified" role="tablist">
				<li class="nav-item" role="presentation">
					<a class="nav-link active" data-bs-toggle="tab" href="#GeneralTab" role="tab" aria-selected="true">
						<span class="d-block d-sm-none"><i class="fas fa-home"></i></span>
						<span class="d-none d-sm-block">General</span>
					</a>
				</li>
				<li class="nav-item" role="presentation" id="tabDocument">
					<a class="nav-link disable" data-bs-toggle="tab" href="#divDocument" role="tab" aria-selected="false" tabindex="-1">
						<span class="d-block d-sm-none"><i class="far fa-user"></i></span>
						<span class="d-none d-sm-block">Document</span>
					</a>
				</li>
			</ul>
			<div class="tab-content p-3 text-muted">
