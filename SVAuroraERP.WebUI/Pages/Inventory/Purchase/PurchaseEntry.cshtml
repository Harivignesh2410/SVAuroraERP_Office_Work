					<div class="row g-3 mb-2">
						<div class="col-lg-3 col-md-6">
							<div class="form-group" id="divBillNo">
								<label>Bill No&nbsp;<span class="text-danger">*</span></label>
								<input type="text" id="txtBillNo" class="form-control MaxThreshold" placeholder="Please enter Bill No" maxlength="50" />
							</div>
						</div>
						<div class="col-lg-3">
							<div class="form-group" id="divBillDate">
								<label>Date&nbsp;<span class="text-danger">*</span></label>
								<div class="input-group">
									<div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
									<input type="text" id="txtBillDate" class="form-control" name="txtBillDate" title="Click to view Calendar" readonly="readonly" />
									<div class="input-group-text ClearDate"><i class="fas fa-eraser"></i></div>
								</div>
							</div>
						</div>
						<div class="col-lg-3 col-md-6">
							<div class="form-group" id="divSupplier">
								<label>Select Supplier&nbsp;<span class="text-danger">*</span></label>
								<select id="ddlSupplierType" class="form-control select2 " data-placeholder="Supplier" asp-items="Model.SupplierList">
								</select>
							</div>
						</div>
						<div class="col-lg-3 col-md-6 py-4">
							<button id="btnAddNewItems" class="btn btn-success btn-sm btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#divAddUnitModal" title="Click here to Add New Item"><i class="fas fa-plus-square align-middle me-1"></i>Add New Item</button>
						</div>
					</div>
					<div class="table-responsive">
						<div id="divTableData">
						</div>
					</div>

					<div class="alert alert-info" role="alert">
						Summary
					</div>
					<div class="row g-3">
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divRound1Summary">
								<label class="col-form-label">Rounded Off(+)(Rs.)</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtRoundOff1" class="form-control text-end decimal" name="RoundOff1" placeholder="0.00" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divRound2Summary">
								<label class="col-form-label">Rounded Off(-)(Rs.)</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtRoundOff2" class="form-control text-end decimal" name="RoundOff2" placeholder="0.00" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTax1">
								<label class="col-form-label">Other Charges</label>
								<select id="ddlFinalOtherCharges" class="form-control select2" data-placeholder="Tax 1">
								</select>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divfinalOtherCharge">
								<label class="col-form-label">Amount</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtfinalOthercharge" class="form-control text-end decimal" placeholder="0.00" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divGrossAmount">
								<label class="col-form-label">GrossAmount</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtGrossAmount" class="form-control text-end" readonly="readonly" placeholder="0.00" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTax3">
								<label class="col-form-label">Select Tax</label>
								<select id="ddlFinalTax1" class="form-control select2" data-placeholder="Tax 1">
								</select>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTaxAmount">
								<label class="col-form-label">Amount(Rs.)</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtFinalTaxAmount1" class="form-control text-end" placeholder="0.00" readonly="readonly" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTax3">
								<label class="col-form-label">Select Tax</label>
								<select id="ddlFinalTax2" class="form-control select2" data-placeholder="Tax 1">
								</select>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTaxAmount">
								<label class="col-form-label">Amount(Rs.)</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtFinalTaxAmount2" class="form-control text-end" placeholder="0.00" readonly="readonly" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divTotalTaxAmount">
								<label class="col-form-label">Total Tax(Rs.)</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtfinalTotalTax" class="form-control text-end" placeholder="0.00" readonly="readonly" />
								</div>
							</div>
						</div>
						<div class="col-lg-2 col-md-6">
							<div class="form-group" id="divNetBillAmount">
								<label class="col-form-label">Net Bill Amount</label>
								<div class="input-group">
									<div class="input-group-text"><i class="fas fa-rupee-sign"></i></div>
									<input type="text" id="txtNetBillAmount" class="form-control text-end" placeholder="0.00" readonly="readonly" />
								</div>
							</div>
						</div>
						<div class="col-lg-12 col-md-6">
							<label class="form-label">Narration</label>
							<textarea required="" class="form-control" rows="3" placeholder="Narration" id="txtNarration"></textarea>
