@page
@model SVAuroraERP.WebUI.Pages.Orders.Invoice.CreateInvoiceModel
@{
    ViewData["Title"] = "Create Invoice";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Create Invoice</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Orders</a></li>
                    <li class="breadcrumb-item active">Invoice</li>
                    <li class="breadcrumb-item active">Create Invoice</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="WebPageContent d-none">
    <div id="divSummary" class="card mb-3">
        <div class="card-body border-bottom">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 card-title flex-grow-1"></h5>
                <div class="flex-shrink-0">
                    <button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
                        <i class="mdi mdi-refresh label-icon"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body" id="divRecords">
            <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                <table id="tblSummarylist" class="table  align-middle dt-responsive nowrap w-100 table-check">
                    <thead class="table-light">
                        <tr>
                            <th>S No.</th>
                            <th>PO No.</th>
                            <th>Dealer Code</th>
                            <th>Dealer Name</th>
                            <th>Dealer City</th>
                            <th>Order Count</th>
                            <th>Action </th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Dynamic data here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mt-2" id="divOrderList">
        <div class="card-header bg-info bg-gradient d-flex justify-content-between align-items-center">
            <h5 class="card-title text-white">
                <i class="fas fa-plus-square align-middle me-1"></i>    Invoice Details
            </h5>
            <button type="button" class="btn-close btn-close-white" id="btnCloseWindow"></button>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Left Column: 25% width for Form -->
