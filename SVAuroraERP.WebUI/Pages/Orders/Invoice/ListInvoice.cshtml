@page
@model SVAuroraERP.WebUI.Pages.Orders.Invoice.ListInvoiceModel
@{
    ViewData["Title"] = "List Invoice";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18"> List Invoice </h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Orders</a></li>
                    <li class="breadcrumb-item active">Invoice</li>
                    <li class="breadcrumb-item active">List Invoice</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="WebPageContent d-none">
    <div id="divAdvancedFilter" class="no-bg mb-3">
        <div class="accordion custom-accordionwithicon custom-accordion-border accordion-border-box accordion-secondary">
            <div class="accordion-item">
                <h2 class="accordion-header" id="accHeader">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#divAdvancedFilterBody" aria-expanded="true" aria-controls="divAdvancedFilterBody">
                        <i class="bx bx-filter-alt me-2"></i> Advanced Filter
                    </button>
                </h2>
                <div id="divAdvancedFilterBody" class="accordion-collapse collapse show" aria-labelledby="accHeader" data-bs-parent="#divAdvancedFilter">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label class="col-form-label">Date</label>
                                    <div class="input-daterange input-group" id="datepicker6" data-date-format="dd M, yyyy" data-date-autoclose="true" data-provide="datepicker" data-date-container="#datepicker6">
                                        <input type="text" class="form-control" name="start" readonly="true" placeholder="From Date" id="txtStartDate">
                                        <input type="text" class="form-control" name="end" readonly="true" placeholder="To Date" id="txtEndDate">
                                    </div>
                                </div>
                            </div>                          
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="ddlOEMFilter" class="col-form-label">OEM</label>
                                    <select id="ddlOEMFilter" class="form-select select2" data-placeholder="--Select OEM--">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="ddlDealerFilter" class="col-form-label">Dealer</label>
                                    <select id="ddlDealerFilter" class="form-select select2" data-placeholder="--Select Dealer--">
                                    </select>
                                </div>
                            </div>                         
                           
                            <div class="col-md-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="col-form-label d-block">&nbsp;</label>
                                        <button type="button" class="btn btn-outline-secondary btn-rounded waves-effect w-100" id="btnClearFilter">
                                            <i class="bi bi-x-circle"></i> Clear
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="col-form-label d-block">&nbsp;</label>
                                        <button class="btn btn-warning btn-rounded w-100 waves-effect" id="btnFilter">
                                            <i class="bx bx-filter-alt font-size-16 align-middle me-2"></i> Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card mt-2" id="divRecords">
        <div class="card-body border-bottom">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 card-title flex-grow-1"></h5>
                <div class="flex-shrink-0">
                    <button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
                        <i class="mdi mdi-refresh label-icon"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                <table id="tblrecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
                    <thead class="table-light">
                        <tr>
                            <th>S No.</th>
                            <th>Invoice No</th>
                            <th>Invoice Date</th>
                            <th>DealerCode</th>
                            <th>Dealer</th>
                            <th>City</th>
                            <th>OrderCount</th>
                            <th>Invoice Amount</th>
                             <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mt-2" id="divOrderList">
        <div class="card-header bg-info bg-gradient d-flex justify-content-between align-items-center">
            <h5 class="card-title text-white">
                <i class="bx bx-list-check align-middle me-1"></i>    Invoice Details
            </h5>
            <button type="button" class="btn-close btn-close-white" id="btnCloseWindow"></button>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Left Column: 25% width for Form -->
                @*<div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label"><strong>Company Name</strong></label>
                        <input type="text" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Mode of Transport</strong></label>
                        <select class="form-control select2">
                            <option>Select</option>
                            <option>Courier</option>
                            <option>Transport</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Courier</strong></label>
                        <select class="form-control select2">
                            <option>Select</option>
                            <option>Courier</option>
                            <option>Transport</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Docket No</strong></label>
                        <input type="text" class="form-control" placeholder="Please enter DOCKET NO">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Dispatch Date</strong></label>
                        <div class="input-group">
                            <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                            <input type="text" id="txtDispatchDate" class="form-control" name="txtDispatchDate" title="Click to view Calendar" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Consignment Details</strong></label>
                        <textarea class="form-control" rows="2" placeholder="Please enter CONSIGNMENT DETAILS"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Collecting Person</strong></label>
                        <input type="text" class="form-control" placeholder="Please enter  Collecting Person Name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Upload POD Image File (.jpeg, .jpg, .png)</strong></label>
                        <input type="file" class="form-control">
                    </div>
                </div>*@
                <div class="col-md-12">
                    <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                        <table id="tblOrderlist" class="table align-middle dt-responsive nowrap w-100 table-check">
                            <thead class="table-light">
                                <tr>
                                    @*<th><input type="checkbox" id="selectAllCheckbox" title="Select All" /></th>*@
                                    <th>S.No.</th>
                                    <th>Invoice No / Date</th>
                                    <th>Order No / Date</th>
                                    <th>Dealer Code / Name</th>
                                    <th>Reg No / Date</th>
                                    <th>Front / Size</th>
                                    <th>Rear / Size</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button id="btnClose" type="button" class="btn btn-outline-danger waves-effect"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
            </div>
        </div>         
    </div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
@section Scripts {
    <input type="hidden" id="hdnManageJobCardID" />


    <script type="text/javascript">
        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
        // Define the URL as a JavaScript variable
        var ListDataUrl = '@Url.Page("/Orders/Invoice/ListInvoice", "ListInvoice")';
        var ListOrderDataUrl = '@Url.Page("/Orders/Invoice/ListInvoice", "OrderList")';
        var GenerateInvoiceUrl = '@Url.Page("/Orders/Invoice/CreateInvoice", "GenerateInvoice")';
        var OEMListUrl = '@Url.Page("/GlobalFunctions", "OEMList")';
        var DealerListUrl = '@Url.Page("/GlobalFunctions", "DealerList")';
        var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
        var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
        var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
        var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
        var _CMPermissions  = @Json.Serialize(Model.Permissions);
        var currentPageControlID = @Model.CurrentPageControlID;
        var InvoicePDFExportUrl = '@Url.Page("/GlobalReports", "GenerateInvoice")';


    </script>

    <script src="~/customjs/orders/invoice/jlistinvoice.js" type="text/javascript" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var PageAuditData= new Object();
            PageAuditData.PageControlID = currentPageControlID;
            PageAuditData.URL = window.location.href;
            InsertPageAccessAuditLog(_TOKEN,PageAuditData);

        });
    </script>
}
