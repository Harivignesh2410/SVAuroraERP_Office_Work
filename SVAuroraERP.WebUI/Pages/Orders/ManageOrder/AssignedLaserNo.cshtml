@page
@model SVAuroraERP.WebUI.Pages.Orders.ManageOrder.AssignedLaserNoModel
@{
	ViewData["Title"] = "Assigned Laser No";
}
<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Assigned Laser No</h4>

			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
					<li class="breadcrumb-item"><a href="#">Orders</a></li>
					<li class="breadcrumb-item"><a href="#">Manage Order</a></li>
					<li class="breadcrumb-item active">Assigned Laser No</li>
				</ol>
			</div>
		</div>
	</div>
</div>
<div class="WebPageContent d-none">
    <div id="divAdvancedFilter" class="no-bg mb-3">
        <div class="accordion custom-accordionwithicon custom-accordion-border accordion-border-box accordion-secondary">
            <div class="accordion-item">
                <h2 class="accordion-header" id="accHeader">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#divAdvancedFilterBody" aria-expanded="true" aria-controls="divAdvancedFilterBody">
                        <i class="bx bx-filter-alt me-2"></i> Advanced Filter
                    </button>
                </h2>
                <div id="divAdvancedFilterBody" class="accordion-collapse collapse show" aria-labelledby="accHeader" data-bs-parent="#divAdvancedFilter">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label class="col-form-label">Date</label>
                                    <div class="input-daterange input-group" id="datepicker6" data-date-format="dd M, yyyy" data-date-autoclose="true" data-provide="datepicker" data-date-container="#datepicker6">
                                        <input type="text" class="form-control" name="start" readonly="true" placeholder="From Date" id="txtStartDate">
                                        <input type="text" class="form-control" name="end" readonly="true" placeholder="To Date" id="txtEndDate">
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-12 d-none">
                                <div class="form-group">
                                    <label for="ddlEmbossingStationFilter" class="col-form-label">Emobossing Station</label>
                                    <select id="ddlEmbossingStationFilter" class="form-select select2" data-placeholder="--Select Embossing Station--">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="ddlSizeFilter" class="col-form-label">Size</label>
                                    <select id="ddlSizeFilter" class="form-select select2" data-placeholder="--Select Size--">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="ddlColorFilter" class="col-form-label">Color</label>
                                    <select id="ddlColorFilter" class="form-select select2" data-placeholder="--Select Color--">
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="ddlStatusFilter" class="col-form-label">Status</label>
                                    <select id="ddlStatusFilter" class="form-select select2" data-placeholder="--Select Status--">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="col-form-label d-block">&nbsp;</label>
                                        <button type="button" class="btn btn-outline-secondary btn-rounded waves-effect w-100" id="btnClearFilter">
                                            <i class="bi bi-x-circle"></i> Clear
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="col-form-label d-block">&nbsp;</label>
                                        <button class="btn btn-warning btn-rounded w-100 waves-effect" id="btnFilter">
                                            <i class="bx bx-filter-alt font-size-16 align-middle me-2"></i> Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="divAssignedSummary"></div>
    <div class="card">
        <div class="card-body">
            <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                <table id="tblrecordlist"
                       class="table align-middle dt-responsive nowrap w-100 table-check">
                    <thead class="table-light">
                        <tr>
                            <th>S No.</th>
                            <th>Acknowledged Date</th>
                            <th>Dispatch No</th>
                            <th>Serial No</th>
                            <th>Embossing Station</th>
                            <th>Dimension</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>                                
            </div>
        </div>
    </div>
    <div class="modal fade" id="divAddEditModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info">
                    <h5 class="modal-title add-task-title text-white" style="display: block;"><i class="bx bxs-plus-square font-size-20 align-middle me-1"></i> </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <div id="divLaserNoStockLog"></div>  
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button id="btnClose" type="button" class="btn btn-outline-danger waves-effect" data-bs-dismiss="modal"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
                   
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
@section Scripts {
    <input type="hidden" id="hdnHSRPOrderID" />

    <script type="text/javascript">
        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');

        var EmbossingStationListUrl = '@Url.Page("/GlobalFunctions", "EmbossingStationList")';
        var LaserNoStockStatusListUrl = '@Url.Page("/GlobalFunctions", "LaserNoStockStatusList")';
        var VehiclePlateSizeListUrl = '@Url.Page("/GlobalFunctions", "VehiclePlateSizeList")';
        var VehiclePlateColorListUrl = '@Url.Page("/GlobalFunctions", "VehiclePlateColorList")';
        var ListDataUrl = '@Url.Page("/Orders/ManageOrder/AssignedLaserNo", "AssignedLaserNoList")';
        var GetLaserNoStockSummaryUrl = '@Url.Page("/Orders/ManageOrder/AssignedLaserNo", "LaserNoStockSummary")';
        var GetLaserNoStockLogByIDUrl = '@Url.Page("/Orders/ManageOrder/AssignedLaserNo", "LaserNoStockLogByID")';

        var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
        var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
        var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
        var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
        var _CMPermissions  = @Json.Serialize(Model.Permissions);
        var currentPageControlID = @Model.CurrentPageControlID;
    </script>
    <script src="~/customjs/orders/manageorder/jassignedlaserno.js" type="text/javascript" asp-append-version="true"></script>

    <script type="text/javascript">
        $(document).ready(function () {
             var PageAuditData = new Object();
            PageAuditData.PageControlID = currentPageControlID;
            PageAuditData.URL = window.location.href;
            InsertPageAccessAuditLog(_TOKEN, PageAuditData);
        });
    </script>
}
