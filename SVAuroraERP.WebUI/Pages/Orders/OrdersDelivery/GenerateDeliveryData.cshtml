@page
@model SVAuroraERP.WebUI.Pages.Orders.OrdersDelivery.GenerateDeliveryDataModel
@{
    ViewData["Title"] = "Generate Delivery Data";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Generate Delivery Data</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-page="/AppLauncher">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Orders</a></li>
                    <li class="breadcrumb-item active">Orders Delivery</li>
                    <li class="breadcrumb-item active">Generate Delivery Data</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="WebPageContent d-none">
    <div class="card mt-2" id="divRecords">
        <div class="card-body border-bottom">
            <div class="d-flex align-items-center">
                <h5 class="mb-0 card-title flex-grow-1"></h5>
                <div class="flex-shrink-0">
                    <button id="btnRefresh" type="button" class="btn btn-light waves-effect btn-label waves-light" title="Click here to refresh">
                        <i class="mdi mdi-refresh label-icon"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                <table id="tblrecordlist" class="table align-middle dt-responsive nowrap w-100 table-check">
                    <thead class="table-light">
                        <tr>
                            <th>S No.</th>
                            <th>Dealer</th>
                            <th>Dealer PO No</th>
                            <th>Contact No</th>
                            <th>Order(s) Count</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mt-2" id="divOrderList">
        <div class="card-header bg-info bg-gradient d-flex justify-content-between align-items-center">
            <h5 class="card-title text-white">
                <i class="fas fa-dolly-flatbed align-middle me-1"></i>    Generate Delivery Data
            </h5>
            <button type="button" class="btn-close btn-close-white" id="btnCloseWindow"></button>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Left Column: 25% width for Form -->
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label"><strong>Company Name</strong></label>
                        <input type="text" id="txtCompanyName" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Mode of Transport</strong>&nbsp;<span class="text-danger">*</span></label>
                        <select id="ddlModeofTransport" class="form-control select2">
                            <option value="0">--Select--</option>
                            <option value="1">Courier</option>
                            <option value="2">Manual</option>
                            <option value="3">Take Away</option>
                        </select>
                    </div>


                    <div id="divCourierMode" class="mb-3">
                        <label class="form-label"><strong>Courier</strong></label>
                        <select id="ddlCourier" class="form-control select2" data-placeholder="--Select Courier--">
                        </select>
                    </div>

                    <div id="divDocketNo" class="mb-3">
                        <label class="form-label"><strong>Docket No</strong></label>
                        <input type="text" id="txtDocketNo" class="form-control" placeholder="Please enter Docket No">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Dispatch Date</strong>&nbsp;<span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                            <input type="text" id="txtDispatchDate" class="form-control" name="txtDispatchDate" title="Click to view Calendar" />
                            <div class="input-group-text ClearDate"><i class="fas fa-eraser"></i></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Consignment Details</strong></label>
                        <textarea class="form-control" id="txtConsignmentDetails" rows="2" placeholder="Please enter CONSIGNMENT DETAILS"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Collecting Person</strong></label>
                        <input type="text" class="form-control" id="txtCollectingPerson" placeholder="Please enter  Collecting Person Name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><strong>Upload POD Image File (.jpeg, .jpg, .png)</strong></label>
                        <input type="file" id="fileUploadImage" class="form-control" accept=".jpg,.jpeg,.png" />
                    </div>

                </div>
                <div class="col-md-9">
                    <div id="selectedCount" class="alert alert-warning text-end py-2 mb-2 fs-6" role="alert">
                        Selected 0 out of 0
                        </div>

                    <div class="dataTables_wrapper dt-bootstrap4 no-footer mt-2">
                        <table id="tblOrderlist" class="table align-middle dt-responsive nowrap w-100 table-check">
                            <thead class="table-light">
                                <tr>
                                    <th><input type="checkbox" id="selectAllCheckbox" title="Select All" /></th>
                                    <th>S.No.</th>
                                    <th>Order No/Date</th>
                                    <th>Reg No/Date</th>
                                    <th>Front/Size</th>
                                    <th>Back/Size</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                    
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button id="btnClose" type="button" class="btn btn-outline-danger waves-effect"><i class="fas fa-window-close font-size-16 me-2"></i>Close</button>
                <button id="btnSave" type="button" class="btn btn-success waves-effect waves-light"><i class="fas fa-dolly-flatbed font-size-20 align-middle me-2"></i>Save</button>

            </div>
        </div>
    </div>
</div>
<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>
@section Scripts {
    <input type="hidden" id="hdnGenerateDeliveryDataID" />


    <script type="text/javascript">
        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
        // Define the URL as a JavaScript variable
        var ListDataUrl = '@Url.Page("/Orders/OrdersDelivery/GenerateDeliveryData", "ListInvoice")';
        var ListOrderDataUrl = '@Url.Page("/Orders/OrdersDelivery/GenerateDeliveryData", "HSRPInvoiceByDealer")';
        var CourierListUrl = '@Url.Page("/GlobalFunctions", "Courier")';
        var SaveUpdateDataUrl = '@Url.Page("/Orders/OrdersDelivery/GenerateDeliveryData", "SaveUpdateData")';
        var _CMActionAdd = @Json.Serialize(Model.Permissions.HasAdd);
        var _CMActionUpdate = @Json.Serialize(Model.Permissions.HasEdit);
        var _CMActionDelete = @Json.Serialize(Model.Permissions.HasDelete);
        var _CMActionView = @Json.Serialize(Model.Permissions.HasView);
        var _CMPermissions  = @Json.Serialize(Model.Permissions);
        var currentPageControlID = @Model.CurrentPageControlID;
        var InvoicePDFExportUrl = '@Url.Page("/GlobalReports", "GenerateInvoice")';


    </script>
    <script src="~/customjs/orders/ordersdelivery/jgeneratedeliverydata.js" type="text/javascript" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var PageAuditData= new Object();
            PageAuditData.PageControlID = currentPageControlID;
            PageAuditData.URL = window.location.href;
            InsertPageAccessAuditLog(_TOKEN,PageAuditData);
        });
    </script>
}
