<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign-In | SV Aurora ERP</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta content="SV Aurora ERP" name="description" />
    <meta content="SV Aurora ERP" name="author" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Sweet Alert-->
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" asp-append-version="true" />

    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/assets/js/detect.js" type="text/javascript" asp-append-version="true"></script>

    <!-- sweetalert2 -->
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js" type="text/javascript" asp-append-version="true"></script>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>