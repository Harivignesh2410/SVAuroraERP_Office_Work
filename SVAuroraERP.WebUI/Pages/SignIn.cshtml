@page
@model SVAuroraERP.WebUI.Pages.SignInModel
@{
    Layout = "_LayoutSignIn";
}

<div class="account-pages my-5 pt-sm-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card overflow-hidden" id="divSignin">
                    <div class="bg-info">
                        <div class="row">
                            <div class="col-12 mt-2 d-none">
                                <h5 class="text-white text-center"><strong>Street Light Survey</strong> @Model.AppVersion</h5>
                            </div>
                            <div class="col-7">
                                <div class="text-white p-4">
                                    <h5 class="text-white">Welcome Back !</h5>
                                    <p>Sign in to continue</p>

                                </div>
                            </div>
                            <div class="col-5 align-self-end">
                                <img src="~/assets/images/profile-img.png" alt="" class="img-fluid">
                            </div>
                        </div>
                    </div>
                    <div class="card-body pt-0">
                        <div class="auth-logo">
                            <a href="#" class="auth-logo-light">
                                <div class="avatar-md profile-user-wid mb-4">
                                    <span class="avatar-title rounded-circle bg-light">
                                        <img src="~/assets/images/logo-light.svg" alt="" class="rounded-circle" height="50">
                                    </span>
                                </div>
                            </a>
                            <a href="#" class="auth-logo-dark">
                                <div class="avatar-md profile-user-wid mb-4">
                                    <span class="avatar-title rounded-circle bg-light">
                                        <img src="~/assets/images/favicon.ico" alt="" class="rounded-circle" height="40">
                                    </span>
                                </div>
                            </a>
                            <h5 class="text-primary bg-gradient text-end"><strong>SV Aurora ERP</strong> @Model.AppEdition @Model.AppVersion</h5>
                        </div>
                        <div class="p-2">
                            <input type="hidden" id="hdnReturnUrl" asp-for="ReturnUrl" />
                            <div class="mb-3">
                                @* <label class="col-form-label">User Type</label> *@
                                @* <select id="ddlApplicationList " class="form-select select2 d-none" asp-items="Model.ApplicationList" asp-data-placeholder="Select User Type"> *@
                                @* </select> *@
                            </div>
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <div class="input-group">
                                    <div class="input-group-text"><i class="fas fa-user"></i></div>
                                    <input type="text" class="form-control" id="txtUserName" placeholder="Please enter username" asp-for="Input.Username">
                                </div>
                                <span asp-validation-for="Input.Username" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <div class="input-group">
                                    <div class="input-group-text"><i class="fas fa-key"></i></div>
                                    <input type="password" id="txtPassword" class="form-control" placeholder="Please enter password" aria-label="Password" asp-for="Input.Password" aria-describedby="password-addon">
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <div class="mt-3 d-grid">
                                <button id="btnSignIn" class="btn btn-info waves-effect waves-light" type="button">
                                    <span id="btnText"><i class="fas fa-user-lock font-size-16 align-middle me-2"></i>Sign In</span>
                                    <span id="loadingSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                </button>
                            </div>
                            <div class="mt-4 text-center d-none">
                                <a href="#" class="text-muted"><i class="mdi mdi-lock me-1"></i> Forgot your password?</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 text-center">
                    <div>
                        <p>©
                        <script>document.write(new Date().getFullYear())</script>&nbspSV Aurora ERP @Model.AppVersion by&nbsp;SV Aurora Innovations</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<span id="anti-forgery-token" data-token="@Model.AntiforgeryToken"></span>

@section Scripts {
    <script src="~/assets/js/detect.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/customjs/authentication/jsignin.js" type="text/javascript" asp-append-version="true"></script>

    <script type="text/javascript">
        // Define the URL as a JavaScript variable
        var SignInURL = '@Url.Page("/SignIn", "UserSignIn")';

        var _TOKEN = document.getElementById('anti-forgery-token').getAttribute('data-token');
    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            // $('#ddlApplicationList').select2({
            //     dropdownParent: $('#divSignin'),
            //     width: '100%'
            // });
        });
    </script>
}