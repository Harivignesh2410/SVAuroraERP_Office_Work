@page
@model SVAuroraERP.WebUI.Pages.SignoutModel
@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <meta content="SV Aurora ERP" name="description" />
    <meta content="SV Aurora ERP" name="author" />

    <title>SignOut | SV Aurora ERP</title>

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" asp-append-version="true" />
</head>

<body>
    <div class="account-pages my-5 pt-sm-5">
        <div class="container">
            <div class="row d-none">
                <div class="col-lg-12">
                    <div class="text-center mb-5 text-muted">
                        <a class="d-block auth-logo" asp-page="/SignIn">
                            <img src="~/assets/images/logo-dark.png" alt="" height="20" class="auth-logo-dark mx-auto">
                            <img src="~/assets/images/logo-light.png" alt="" height="20" class="auth-logo-light mx-auto">
                        </a>
                        <p class="mt-3 d-none">SV Aurora ERP</p>
                    </div>
                </div>
            </div>
            <!-- end row -->
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card">

                        <div class="card-body">

                            <div class="p-2">
                                <div class="text-center">

                                    <div class="avatar-md mx-auto">
                                        <div class="avatar-title rounded-circle bg-light">
                                            <i class="bx bx-check-circle fa-5x mb-0 text-success"></i>
                                        </div>
                                    </div>
                                    <div class="p-2 mt-4">
                                        <h4>You have been successfully signed out!</h4>
                                        <p class="text-muted d-none">You have been signed out!</p>
                                        <div class="mt-4">
                                            <a class="btn btn-info" asp-page="/SignIn">Sign In Again</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="mt-5 text-center">

                        <p>© <script>document.write(new Date().getFullYear())</script>&nbsp;&nbsp;SV Aurora Innovations</p>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js" type="text/javascript" asp-append-version="true"></script>
</body>
</html>